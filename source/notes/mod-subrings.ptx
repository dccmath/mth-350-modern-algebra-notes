      </cell>
      <cell right="medium" bottom="medium">
      </cell>
      <cell right="medium" bottom="medium">
      </cell>
      <cell halign="left" bottom="medium">
      </cell>
    </row>
    <row bottom="medium">
      <cell right="medium">
        <m>([0]_2,[1]_3)</m>
      </cell>
      <cell right="medium">
      </cell>
      <cell right="medium">
      </cell>
      <cell right="medium">
      </cell>
